{
  "name": "open-symlink-original-file",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "icon": "assets/UnitedBranchIcon.png",
  "publisher": "Unit3dBranch",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Unit3dBranch/open-symlink-original-file.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "%ext.category.other%"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onDidOpenTextDocument"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.openOriginalFile",
        "title": "%command.openOriginalFile.title%"
      },
      {
        "command": "extension.openSymlinksToOriginal",
        "title": "%command.openSymlinksToOriginal.title%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "extension.openOriginalFile",
          "when": "isSymlinkFile",
          "group": "navigation"
        },
        {
          "command": "extension.openSymlinksToOriginal",
          "when": "!isSymlinkFile",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "extension.openOriginalFile",
          "when": "isSymlinkFile",
          "group": "navigation"
        },
        {
          "command": "extension.openSymlinksToOriginal",
          "when": "!isSymlinkFile",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "extension.openOriginalFile",
          "when": "isSymlinkFile",
          "group": "navigation"
        },
        {
          "command": "extension.openSymlinksToOriginal",
          "when": "!isSymlinkFile",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1"
  },
  "dependencies": {
    "vscode-nls": "^5.2.0"
  }
}
