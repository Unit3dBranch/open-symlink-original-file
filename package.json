{
  "name": "open-symlink-original-file",
  "displayName": "Open Symlink Original File",
  "icon": "assets/UnitedBranchIcon.png",
  "description": "An extension able to track the original file from the symlink and provide an option to open the original file directly from the navigation menu.",
  "publisher": "Unit3dBranch",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onDidOpenTextDocument"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.openOriginalFile",
        "title": "Open the Original File"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "extension.openOriginalFile",
          "when": "isSymlinkFile",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "extension.openOriginalFile",
          "when": "isSymlinkFile",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.25.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
